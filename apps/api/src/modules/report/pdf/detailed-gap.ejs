<% var services = gap.hasServices ? gap.recommendedServices.slice(serviceStartIndex, serviceEndIndex) : []; %>

<div class="flex flex-col pt-4 pb-6 border-b border-border last:border-b-0">

  <% if (showGapHeader) { %>
    <!-- Gap heading + status badge -->
    <div class="flex items-start justify-between gap-4 w-full">
      <span class="font-medium text-base break-words min-w-0"><%= t.detailedReport.gapLabel %> <%= index + 1 %>: <%= gap.gapDescription %></span>
      <% if (gap.hasServices) { %>
        <span class="shrink-0 uppercase text-xs font-semibold text-[#0D9488]"><%= gap.recommendedServices.length > 1 ? t.detailedReport.servicesAvailable : t.detailedReport.serviceAvailable %></span>
      <% } else { %>
        <span class="shrink-0 uppercase text-xs font-semibold text-[#854D0E]"><%= t.detailedReport.comingSoon %></span>
      <% } %>
    </div>
  <% } %>

  <% if (gap.hasServices && services.length > 0) { %>
    <!-- Services table (Services | Description). The column header repeats when a
         gap's services continue on the next page. -->
    <div class="flex flex-col mt-4">
      <div class="grid grid-cols-[38%_minmax(0,1fr)] gap-6 bg-neutral-50 rounded-[8px] px-4 py-2.5">
        <span class="text-sm text-muted-foreground"><%= t.detailedReport.servicesColumnLabel %></span>
        <span class="text-sm text-muted-foreground"><%= t.detailedReport.descriptionColumnLabel %></span>
      </div>

      <% services.forEach(function(service, sIdx) { var absIdx = serviceStartIndex + sIdx; %>
        <div class="grid grid-cols-[38%_minmax(0,1fr)] gap-6 px-4 py-4 rounded-[8px] <%= absIdx % 2 === 1 ? 'bg-neutral-50' : '' %>">
          <div class="flex flex-col gap-1.5 min-w-0">
            <span class="text-sm font-medium break-words"><%= service.name %></span>
            <% if (service.url) { %>
              <span class="text-sm font-medium break-all" style="color: <%= accentColor %>"><%= service.url %><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="<%= accentColor %>" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="inline-block align-middle ml-1 shrink-0"><path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></svg></span>
            <% } %>
          </div>
          <span class="text-sm text-muted-foreground break-words"><%= service.description %></span>
        </div>
      <% }) %>
    </div>
  <% } %>

</div>
